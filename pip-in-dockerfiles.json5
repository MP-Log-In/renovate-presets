{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "packageRules": [
        {
            "description": "Automerge Python patch updates from PyPI in Dockerfiles",
            "matchManagers": [
                "custom.regex"
            ],
            "matchDatasources": [
                "pypi"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "automerge": true,
            "automergeStrategy": "rebase",
            "automergeType": "pr",
            "labels": [
                "dependency/automerge",
                "dependency/pypi/patch"
            ],
            "groupName": "python package updates"
        },
        {
            "description": "Automerge Python minor updates from PyPI in Dockerfiles",
            "matchManagers": [
                "custom.regex"
            ],
            "matchDatasources": [
                "pypi"
            ],
            "matchUpdateTypes": [
                "minor"
            ],
            "automerge": true,
            "automergeStrategy": "rebase",
            "automergeType": "pr",
            "labels": [
                "dependency/automerge",
                "dependency/pypi/minor"
            ],
            "groupName": "python package updates"
        },
        {
            "description": "Do not automerge Python major updates from PyPI in Dockerfiles",
            "matchManagers": [
                "custom.regex"
            ],
            "matchDatasources": [
                "pypi"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": false,
            "automergeStrategy": "rebase",
            "automergeType": "pr",
            "labels": [
                "dependency/automerge/disabled",
                "dependency/pypi/major"
            ]
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "**/[Dd]ockerfile*",
                "**/[Cc]ontainerfile*",
                "**/*.[Dd]ockerfile*",
                "**/*.[Cc]ontainerfile*",
                "versions.*.env",
                "**/versions.*.env",
            ],
            // Pattern:
            // # renovate:pypi [packageName=NAME] depName=NAME [registryUrl=URL] [versioning=pep440]
            // ARG FOO_VERSION="1.2.3"
            // or:
            // FOO_VERSION=1.2.3
            "matchStrings": [
                "(?m)^#\\s*renovate:pypi\\s+(?:packageName=(?<packageName>\\S+)\\s+)?depName=(?<depName>\\S+)(?:\\s+registryUrl=(?<registryUrl>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?\\s*$(?:\\r?\\n^#.*$)*\\r?\\n^[ \\t]*(?:ARG\\s+)?(?<argName>[A-Za-z0-9_]+_VERSION)=?\"?(?<currentValue>[^\"\\s]+)\"?\\s*$"
            ],
            "datasourceTemplate": "pypi",
            "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}pep440{{/if}}"
        }
    ]
}