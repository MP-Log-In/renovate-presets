{
    // ---------------------------------------------------------
    // Preset: Deno Automerge + Deno JSR/NPM Regex Manager
    // ---------------------------------------------------------
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    // The native Renovate Deno manager is disabled intentionally.
    // This preset manages Deno imports through custom managers to support
    // inline imports, import maps, JSR/NPM CDNs, and self-hosted Gitea tags
    // with a custom lockfile update command using --allow-import.
    "deno": {
        "enabled": false
    },
    "postUpgradeTasks": {
        "commands": [
            "deno install --lockfile-only --allow-import"
        ],
        "fileFilters": [
            "deno.lock",
            "**/deno.lock"
        ],
        "executionMode": "update"
    },
    packageRules: [
        {
            description: "Automerge Deno JSR/NPM patch package version updates",
            matchDatasources: [
                "npm"
            ],
            matchUpdateTypes: [
                "patch"
            ],
            "matchDepTypes": [
                "deno-managed"
            ],
            automerge: true,
            automergeStrategy: "rebase",
            automergeType: "pr",
            labels: [
                "dependency/automerge",
                "dependency/deno/patch"
            ],
            skipArtifactsUpdate: true,
            groupName: "deno jsr/npm package updates",
        },
        {
            description: "Automerge Deno JSR/NPM minor package version updates",
            matchDatasources: [
                "npm"
            ],
            "matchDepTypes": [
                "deno-managed"
            ],
            matchUpdateTypes: [
                "minor",
            ],
            automerge: true,
            automergeStrategy: "rebase",
            automergeType: "pr",
            labels: [
                "dependency/automerge",
                "dependency/deno/minor"
            ],
            skipArtifactsUpdate: true,
            groupName: "deno jsr/npm package updates",
        },
        {
            description: "Automerge Deno JSR/NPM major package version updates",
            matchDatasources: [
                "npm"
            ],
            "matchDepTypes": [
                "deno-managed"
            ],
            matchUpdateTypes: [
                "major",
            ],
            automerge: false,
            automergeStrategy: "rebase",
            automergeType: "pr",
            labels: [
                "dependency/automerge/disabled",
                "dependency/deno/major"
            ],
            skipArtifactsUpdate: true
        },
        {
            description: "Automerge Deno self-hosted Gitea tag patch updates",
            matchManagers: [
                "custom.jsonata",
                "custom.regex"
            ],
            matchDatasources: [
                "gitea-tags"
            ],
            matchRegistryUrls: [
                "https://git.0xmax42.io/**"
            ],
            matchFileNames: [
                "**/import_map.json",
                "**/deno.json",
                "**/deno.jsonc",
                "**/*.ts",
                "**/*.tsx",
                "**/*.js",
                "**/*.jsx"
            ],
            "matchDepTypes": [
                "deno-managed"
            ],
            matchUpdateTypes: [
                "patch"
            ],
            automerge: true,
            automergeStrategy: "rebase",
            automergeType: "pr",
            labels: [
                "dependency/automerge",
                "dependency/deno/patch"
            ],
            skipArtifactsUpdate: true,
            groupName: "deno jsr/npm package updates",
        },
        {
            description: "Automerge Deno self-hosted Gitea tag minor updates",
            matchManagers: [
                "custom.jsonata",
                "custom.regex"
            ],
            matchDatasources: [
                "gitea-tags"
            ],
            matchRegistryUrls: [
                "https://git.0xmax42.io/**"
            ],
            matchFileNames: [
                "**/import_map.json",
                "**/deno.json",
                "**/deno.jsonc",
                "**/*.ts",
                "**/*.tsx",
                "**/*.js",
                "**/*.jsx"
            ],
            "matchDepTypes": [
                "deno-managed"
            ],
            matchUpdateTypes: [
                "minor"
            ],
            automerge: true,
            automergeStrategy: "rebase",
            automergeType: "pr",
            labels: [
                "dependency/automerge",
                "dependency/deno/minor"
            ],
            skipArtifactsUpdate: true,
            groupName: "deno jsr/npm package updates",
        },
        {
            description: "Disable automerge for Deno self-hosted Gitea tag major updates",
            matchManagers: [
                "custom.jsonata",
                "custom.regex"
            ],
            matchDatasources: [
                "gitea-tags"
            ],
            matchRegistryUrls: [
                "https://git.0xmax42.io/**"
            ],
            matchFileNames: [
                "**/import_map.json",
                "**/deno.json",
                "**/deno.jsonc",
                "**/*.ts",
                "**/*.tsx",
                "**/*.js",
                "**/*.jsx"
            ],
            "matchDepTypes": [
                "deno-managed"
            ],
            matchUpdateTypes: [
                "major"
            ],
            automerge: false,
            automergeStrategy: "rebase",
            automergeType: "pr",
            labels: [
                "dependency/automerge/disabled",
                "dependency/deno/major"
            ],
            skipArtifactsUpdate: true,
        },
    ],
    customManagers: [
        // JSR
        {
            // Derived from Omochice Renovate config (zlib License), modified.
            // [License](LICENSES/zlib-omochice.txt)
            "customType": "jsonata",
            "fileFormat": "json",
            "managerFilePatterns": [
                "/(?:^|/)import_map.json$/",
                "/(?:^|/)deno.jsonc?$/"
            ],
            "matchStrings": [
                "imports.*[$ ~> /^(jsr:|https:\\/\\/jsr.io\\/)/i] ~> $map(function($v) {( $package := $v ~> $replace(/^(jsr:|https:\\/\\/jsr.io\\/)/i, '') ~> /(@(.+?)/(.+?))[@|\\/]((\\^|~|>|>=|<)?(0|[1-9]\\d*)(\\.(0|[1-9]\\d*)(\\.(0|[1-9]\\d*)(-((0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(\\+([0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*))?)?)?)/; { 'depName': $package.groups[0], 'packageName': '@jsr/' & $package.groups[1] & '__' & $package.groups[2], 'currentValue': $package.groups[3] })})"
            ],
            "datasourceTemplate": "npm",
            "versioningTemplate": "npm",
            "registryUrlTemplate": "https://npm.jsr.io",
            "depTypeTemplate": "deno-managed"
        },
        {
            // Derived from Omochice Renovate config (zlib License), modified.
            // [License](LICENSES/zlib-omochice.txt)
            "customType": "regex",
            "managerFilePatterns": [
                "/\\.[jt]sx?$/"
            ],
            "matchStrings": [
                "((?:im|ex)port(?:.|\\s)+?from\\s*|//\\s*@deno-types=|//\\s*@ts-types=)['\"]jsr:(?<depName>@(?<namespace>.+?)/(?<package>.+?))@(?<currentValue>(\\^|~|>|>=|<)?(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?)?)?)[/'\"]",
                "((?:im|ex)port(?:.|\\s)+?from\\s*|//\\s*@deno-types=|//\\s*@ts-types=)['\"]https://jsr.io/(?<depName>@(?<namespace>.+?)/(?<package>.+?))/(?<currentValue>(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?)?)?)[/'\"]"
            ],
            "datasourceTemplate": "npm",
            "registryUrlTemplate": "https://npm.jsr.io",
            "versioningTemplate": "npm",
            "packageNameTemplate": "@jsr/{{namespace}}__{{package}}",
            "depTypeTemplate": "deno-managed"
        },
        // NPM
        {
            // Derived from Omochice Renovate config (zlib License), modified.
            // [License](LICENSES/zlib-omochice.txt)
            "customType": "jsonata",
            "fileFormat": "json",
            "managerFilePatterns": [
                "/(?:^|/)import_map.json$/",
                "/(?:^|/)deno.jsonc?$/"
            ],
            "matchStrings": [
                "imports.*[$ ~> /^(npm:|https:\\/\\/(esm\\.sh|unpkg\\.com|cdn\\.skypack\\.dev)\\/)/i] ~> $map(function($v) {( $package := $v ~> $replace(/^(npm:\\/?|https:\\/\\/(esm\\.sh|unpkg\\.com|cdn\\.skypack\\.dev)\\/)/i, '') ~> /^(.+?)@v?((\\^|~|>|>=|<)?(0|[1-9]\\d*)(\\.(0|[1-9]\\d*)(\\.(0|[1-9]\\d*)(-((0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(\\+([0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*))?)?)?)/; { 'depName': $package.groups[0], 'currentValue': $package.groups[1] })})"
            ],
            "versioningTemplate": "npm",
            "datasourceTemplate": "npm",
            "depTypeTemplate": "deno-managed"
        },
        {
            // Derived from Omochice Renovate config (zlib License), modified.
            // [License](LICENSES/zlib-omochice.txt)
            "customType": "regex",
            "managerFilePatterns": [
                "/\\.[jt]sx?$/"
            ],
            "matchStrings": [
                "((?:im|ex)port(?:.|\\s)+?from\\s*|//\\s*@deno-types=|//\\s*@ts-types=)['\"]https://esm.sh/(v\\d{1,3}/)?(?<depName>.+?)@(?<currentValue>(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?)?)?)[?/'\"]",
                "((?:im|ex)port(?:.|\\s)+?from\\s*|//\\s*@deno-types=|//\\s*@ts-types=)['\"]npm:(?<depName>.+?)@(?<currentValue>(?:~|\\^|>|>=|<)?(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?)?)?)[/'\"]",
                "((?:im|ex)port(?:.|\\s)+?from\\s*|//\\s*@deno-types=|//\\s*@ts-types=)['\"]https?://unpkg.com/(?<depName>(?:@[^/\"']*/)?[^/\"']*?)@(?<currentValue>(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?)?)?)[/'\"]",
                "((?:im|ex)port(?:.|\\s)+?from\\s*|//\\s*@deno-types=|//\\s*@ts-types=)['\"]https?://cdn.skypack.dev/(?<depName>(?:@[^/\"']*/)?[^/\"']*?)@(?<currentValue>(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?)?)?)[?/'\"]"
            ],
            "versioningTemplate": "npm",
            "datasourceTemplate": "npm",
            "depTypeTemplate": "deno-managed"
        },
        // // Deno Land
        // {
        //     // Derived from Omochice Renovate config (zlib License), modified.
        //     // [License](LICENSES/zlib-omochice.txt)
        //     "customType": "jsonata",
        //     "fileFormat": "json",
        //     "managerFilePatterns": [
        //         "/(?:^|/)import_map.json$/",
        //         "/(?:^|/)deno.jsonc?$/"
        //     ],
        //     "matchStrings": [
        //         "imports.*[$ ~> /^https:\\/\\/deno.land\\/(x\\/|std)/i] ~> $map(function($v) {( $package := $v ~> /^(https:\\/\\/deno.land\\/(x\\/.+?|std))@(v?(0|[1-9]\\d*)(\\.(0|[1-9]\\d*)(\\.(0|[1-9]\\d*)(-((0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(\\+([0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*))?)?)?)/; { 'currentValue': $package.groups[2], 'depName': $package.groups[0] })})"
        //     ],
        //     "datasourceTemplate": "deno"
        // },
        // {
        //     // Derived from Omochice Renovate config (zlib License), modified.
        //     // [License](LICENSES/zlib-omochice.txt)
        //     "customType": "regex",
        //     "managerFilePatterns": [
        //         "/\\.[jt]sx?$/"
        //     ],
        //     "matchStrings": [
        //         "((?:im|ex)port(?:.|\\s)+?from\\s*|//\\s*@deno-types=|//\\s*@ts-types=)['\"](?<depName>https://deno.land/(?:x?.+?|std))@(?<currentValue>v?(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?)?)?)[/'\"]"
        //     ],
        //     "datasourceTemplate": "deno"
        // },
        // Github Tag
        // {
        //     // Derived from Omochice Renovate config (zlib License), modified.
        //     // [License](LICENSES/zlib-omochice.txt)
        //     "customType": "jsonata",
        //     "fileFormat": "json",
        //     "managerFilePatterns": [
        //         "/(?:^|/)import_map.json$/",
        //         "/(?:^|/)deno.jsonc?$/"
        //     ],
        //     "matchStrings": [
        //         "imports.*[$ ~> /^https:\\/\\/(raw\\.githubusercontent\\.com|pax\\.deno\\.dev)\\//i] ~> $map(function($v) {( $package := $v ~> $replace(/^https:\\/\\/(raw\\.githubusercontent\\.com|pax\\.deno\\.dev)\\//, '') ~> /^((.+?)\\/(.+?))[/@](.+?)($|\\/)/; { 'depName': $package.groups[0], 'currentValue': $package.groups[3] })})"
        //     ],
        //     "datasourceTemplate": "github-tags"
        // },
        // {
        //     // Derived from Omochice Renovate config (zlib License), modified.
        //     // [License](LICENSES/zlib-omochice.txt)
        //     "customType": "regex",
        //     "managerFilePatterns": [
        //         "/\\.[jt]sx?$/"
        //     ],
        //     "matchStrings": [
        //         "((?:im|ex)port(?:.|\\s)+?from\\s*|//\\s*@deno-types=|//\\s*@ts-types=)['\"]https://pax.deno.dev/(?<depName>.+?/.+?)@(?<currentValue>[^/\"']+?)[/\"']",
        //         "((?:im|ex)port(?:.|\\s)+?from\\s*|//\\s*@deno-types=|//\\s*@ts-types=)['\"]https://raw.githubusercontent.com/(?<depName>.+?/.+?)/(?<currentValue>[^'\"]+?)[/'\"]"
        //     ],
        //     "datasourceTemplate": "github-tags"
        // },
        // Gitea Tag
        {
            // Minimal adaptation of the working GitHub Tag manager for self-hosted Gitea tags.
            // Derived from Omochice Renovate config (zlib License), modified.
            "customType": "jsonata",
            "fileFormat": "json",
            "managerFilePatterns": [
                "/(?:^|/)import_map.json$/",
                "/(?:^|/)deno.jsonc?$/"
            ],
            "matchStrings": [
                "imports.*[$ ~> /^https:\\/\\/git\\.0xmax42\\.io\\//i] ~> $map(function($v) {( $package := $v ~> $replace(/^https:\\/\\/git\\.0xmax42\\.io\\//, '') ~> /^((.+?)\\/(.+?))\\/raw\\/tag\\/(.+?)($|\\/)/; { 'depName': $package.groups[0], 'currentValue': $package.groups[3] })})"
            ],
            "datasourceTemplate": "gitea-tags",
            "versioningTemplate": "semver-coerced",
            "registryUrlTemplate": "https://git.0xmax42.io/",
            "packageNameTemplate": "{{depName}}",
            "depTypeTemplate": "deno-managed"
        },
        {
            // Minimal adaptation of the working GitHub Tag manager for self-hosted Gitea tags.
            // Derived from Omochice Renovate config (zlib License), modified.
            "customType": "regex",
            "managerFilePatterns": [
                "/\\.[jt]sx?$/"
            ],
            "matchStrings": [
                "((?:im|ex)port(?:.|\\s)+?from\\s*|//\\s*@deno-types=|//\\s*@ts-types=)['\"]https://git\\.0xmax42\\.io/(?<depName>.+?/.+?)/raw/tag/(?<currentValue>[^/\"']+?)[/\"']"
            ],
            "datasourceTemplate": "gitea-tags",
            "versioningTemplate": "semver-coerced",
            "registryUrlTemplate": "https://git.0xmax42.io/",
            "packageNameTemplate": "{{depName}}",
            "depTypeTemplate": "deno-managed"
        }
    ],
}