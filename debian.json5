{
    // ---------------------------------------------------------
    // Preset: Debian Automerge + Debian Docker Regex Manager
    // ---------------------------------------------------------
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    suppressNotifications: [
        "dependencyLookupWarnings"
    ],
    "postUpgradeTasks": {
        "executionMode": "update",
        "commands": [
            "bump-debian-snapshot.py"
        ],
        "dataFileTemplate": "{{{ toJSON upgrades }}}",
        "fileFilters": [
            "Dockerfile",
            "**/Dockerfile",
            "**/Dockerfile.*",
            "versions.*.env",
            "**/versions.*.env",
        ],
    },
    packageRules: [
        {
            description: "Automerge digest updates for debian base images",
            matchManagers: [
                "dockerfile"
            ],
            matchDatasources: [
                "docker"
            ],
            matchPackageNames: [
                "debian"
            ],
            matchUpdateTypes: [
                "digest"
            ],
            automerge: true,
            automergeStrategy: "rebase",
            automergeType: "pr",
            labels: [
                "dependency/automerge",
                "dependency/debian/docker/digest"
            ]
        },
        {
            description: "Automerge Debian patch package version updates",
            matchDatasources: [
                "deb"
            ],
            matchUpdateTypes: [
                "patch"
            ],
            automerge: true,
            automergeStrategy: "rebase",
            automergeType: "pr",
            labels: [
                "dependency/automerge",
                "dependency/debian/patch"
            ],
            groupName: "debian package updates",
        },
        {
            description: "Automerge Debian minor package version updates",
            matchDatasources: [
                "deb"
            ],
            matchUpdateTypes: [
                "minor",
            ],
            automerge: true,
            automergeStrategy: "rebase",
            automergeType: "pr",
            labels: [
                "dependency/automerge",
                "dependency/debian/minor"
            ],
            groupName: "debian package updates",
        },
        {
            description: "Automerge Debian major package version updates",
            matchDatasources: [
                "deb"
            ],
            matchUpdateTypes: [
                "major",
            ],
            automerge: false,
            automergeStrategy: "rebase",
            automergeType: "pr",
            labels: [
                "dependency/automerge/disabled",
                "dependency/debian/major"
            ],
        },
    ],
    customManagers: [
        // Combined snapshot+security manager to handle both at once
        {
            customType: "regex",
            managerFilePatterns: [
                "/Dockerfile(\\.[A-Za-z0-9_]+)?$/",
                "/(^|/)versions\\.[A-Za-z0-9_]+\\.env$/",
            ],
            // Pattern:
            // # renovate:debian-snapshot+security: suite=XYZ arch=ABC depName=NAME
            // # any other comments
            // ARG FOO_VERSION="1.2.3"
            // or:
            // FOO_VERSION="1.2.3"
            matchStrings: [
                '(?m)^#\\s*renovate:debian-snapshot\\+security:\\s*?(suite=(?<suite>.*?))?\\s*?(arch=(?<arch>.*?))?\\s*depName=(?<depName>.*?)?\\s*$(?:\r?\n^#.*$)*\r?\n^\\s*(?:ARG\\s+)?[A-Za-z_][A-Za-z0-9_]*_VERSION="?(?<currentValue>[^"\r\n]+)"?\\s*$',
            ],
            // Debian Registry URL: Suite from regex or default to 'stable', components fixed, arch from regex or default to 'amd64'
            registryUrlTemplate: "https://snapshot.debian.org/archive/debian-security/{{ env.DEBIAN_SNAPSHOT_TS }}/?suite={{#if suite}}{{suite}}-security{{else}}stable-security{{/if}}&components=main,contrib,non-free&binaryArch={{#if arch}}{{arch}}{{else}}amd64{{/if}}",
            depNameTemplate: "{{depName}}-{{#if arch}}{{arch}}{{else}}amd64{{/if}}-security",
            packageNameTemplate: "{{depName}}",
            datasourceTemplate: "deb",
            versioningTemplate: "deb",
        },
        {
            customType: "regex",
            managerFilePatterns: [
                "/Dockerfile(\\.[A-Za-z0-9_]+)?$/",
                "/(^|/)versions\\.[A-Za-z0-9_]+\\.env$/",
            ],
            // Pattern:
            // # renovate:debian registryUrl=URL suite=XYZ arch=ABC component=XYZ depName=NAME
            // # any other comments
            // ARG FOO_VERSION="1.2.3"
            // or:
            // FOO_VERSION="1.2.3"
            matchStrings: [
                '(?m)^#\\s*renovate:debian-snapshot\\+security:\\s*?(suite=(?<suite>.*?))?\\s*?(arch=(?<arch>.*?))?\\s*depName=(?<depName>.*?)?\\s*$(?:\r?\n^#.*$)*\r?\n^\\s*(?:ARG\\s+)?[A-Za-z_][A-Za-z0-9_]*_VERSION="?(?<currentValue>[^"\r\n]+)"?\\s*$',
            ],
            // Debian Registry URL: Suite from regex or default to 'stable', components fixed, arch from regex or default to 'amd64'
            registryUrlTemplate: "https://snapshot.debian.org/archive/debian/{{ env.DEBIAN_SNAPSHOT_TS }}/?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components=main,contrib,non-free&binaryArch={{#if arch}}{{arch}}{{else}}amd64{{/if}}",
            depNameTemplate: "{{depName}}-{{#if arch}}{{arch}}{{else}}amd64{{/if}}",
            packageNameTemplate: "{{depName}}",
            datasourceTemplate: "deb",
            versioningTemplate: "deb",
        },
        {
            // Manager for Debian package versions in Dockerfiles
            customType: "regex",
            managerFilePatterns: [
                "/Dockerfile(\\.[A-Za-z0-9_]+)?$/",
                "/(^|/)versions\\.[A-Za-z0-9_]+\\.env$/",
            ],
            // Pattern:
            // # renovate:debian registryUrl=URL suite=XYZ arch=ABC component=XYZ depName=NAME
            // # any other comments
            // ARG FOO_VERSION="1.2.3"
            // or:
            // FOO_VERSION="1.2.3"
            matchStrings: [
                '(?m)^#\\s*renovate:debian\\s+(?:registryUrl=(?<registryUrl>\\S+)\\s+)?(?:suite=(?<suite>\\S+)\\s+)?(?:arch=(?<arch>\\S+)\\s+)?(?:component=(?<component>\\S+)\\s+)?depName=(?<depName>\\S+)\\s*$(?:\r?\n^#.*$)*\r?\n^\\s*(?:ARG\\s+)?[A-Za-z_][A-Za-z0-9_]*_VERSION="?(?<currentValue>[^"\r\n]+)"?\\s*$',
            ],
            registryUrlTemplate: "{{#if registryUrl}}{{registryUrl}}{{else}}https://deb.debian.org/debian/{{/if}}?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components={{#if component}}{{component}}{{else}}main,contrib,non-free{{/if}}&binaryArch={{#if arch}}{{arch}}{{else}}amd64{{/if}}",
            depNameTemplate: "{{depName}}-{{#if arch}}{{arch}}{{else}}amd64{{/if}}",
            packageNameTemplate: "{{depName}}",
            datasourceTemplate: "deb",
            versioningTemplate: "deb",
        },
        {
            // Manager for Debian package versions in GitHub Actions/Gitea CI workflows
            customType: "regex",
            managerFilePatterns: [
                "/\\.gitea\\/workflows\\/.*\\.ya?ml$/",
                "/\\.github\\/workflows\\/.*\\.ya?ml$/"
            ],
            matchStrings: [
                "(?m)^\\s*#\\s*renovate:debian\\s+(?:registryUrl=(?<registryUrl>\\S+)\\s+)?(?:suite=(?<suite>\\S+)\\s+)?(?:arch=(?<arch>\\S+)\\s+)?(?:component=(?<component>\\S+)\\s+)?depName=(?<depName>\\S+)\\s*$((?:\\r?\\n^\\s*#.*$)*)\\r?\\n^\\s*?.*?_VERSION=\"(?<currentValue>[^\"]+)\""
            ],
            registryUrlTemplate: "{{#if registryUrl}}{{registryUrl}}{{else}}https://deb.debian.org/debian/{{/if}}?suite={{#if suite}}{{suite}}{{else}}stable{{/if}}&components={{#if component}}{{component}}{{else}}main,contrib,non-free{{/if}}&binaryArch={{#if arch}}{{arch}}{{else}}amd64{{/if}}",
            depNameTemplate: "{{depName}}-{{#if arch}}{{arch}}{{else}}amd64{{/if}}",
            packageNameTemplate: "{{depName}}",
            datasourceTemplate: "deb",
            versioningTemplate: "deb"
        }
    ],
}